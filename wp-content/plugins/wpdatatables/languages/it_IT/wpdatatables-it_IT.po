msgstr "Imposta lo sfasamento superiore per l'ombra esterna."

#: templates/admin/chart_wizard/steps/step4.inc.php:664
msgid "Set left offset for the dropshadow."
msgstr "Imposta lo sfasamento sinistro per l'ombra esterna."

#: templates/admin/chart_wizard/steps/step4.inc.php:687
msgid "Plot border width"
msgstr "Larghezza bordo grafico"

#: templates/admin/chart_wizard/steps/step4.inc.php:716
