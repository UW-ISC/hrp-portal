msgid "Grid stroke dash"
msgstr "Griglia tratteggiata"

#: templates/admin/chart_wizard/steps/step4.inc.php:881
msgid "Creates dashes in the grid. Higher number creates more space between dashes in the border."
msgstr "Crea trattini nella griglia. Un numero più alto crea più spazio tra i trattini nel bordo."

#: templates/admin/chart_wizard/steps/step4.inc.php:909
msgid "Grid position"
msgstr "Posizione della griglia"

#: templates/admin/chart_wizard/steps/step4.inc.php:911
msgid "Whether to place grid behind chart paths of in front."
msgstr "Se posizionare la griglia dietro o davanti ai percorsi del grafico."

#: templates/admin/chart_wizard/steps/step4.inc.php:926
msgid "Axes lines to show"
msgstr "Linee degli assi da mostrare"

#: templates/admin/chart_wizard/steps/step4.inc.php:928
msgid "Choose which axes lines to show"
msgstr "Scegliere quali linee degli assi mostrare"

#: templates/admin/chart_wizard/steps/step4.inc.php:940
msgid "Grid line style"
msgstr "Stile delle linee della griglia"

#: templates/admin/chart_wizard/steps/step4.inc.php:942
msgid "The dash or dot style of the grid lines"
msgstr "Lo stile dei trattini o dei punti delle linee della griglia"

#: templates/admin/chart_wizard/steps/step4.inc.php:967
msgid "Horizontal axis label"
msgstr "Etichetta asse orizzontale"

#: templates/admin/chart_wizard/steps/step4.inc.php:969
msgid "Name of the horizontal axis."
msgstr "Nome dell'asse orizzontale."

#: templates/admin/chart_wizard/steps/step4.inc.php:984
msgid "Horizontal crosshair"
msgstr "Incrocio orizzontale"

#: templates/admin/chart_wizard/steps/step4.inc.php:986
msgid "Configure a horizontal crosshair that follows either the mouse pointer or the hovered point lines"
msgstr "Configura un incrocio orizzontale che segue il puntatore del mouse o le linee dei punti su cui si passa con il mouse"

#: templates/admin/chart_wizard/steps/step4.inc.php:990
msgid "Show x-Axis crosshair"
msgstr "Mostra incrocio asse x"

#: templates/admin/chart_wizard/steps/step4.inc.php:995
msgid "Horizontal axis direction"
msgstr "Direzione asse orizzontale"

#: templates/admin/chart_wizard/steps/step4.inc.php:997
msgid "The direction in which the values along the horizontal axis grow. Specify -1 to reverse the order of the values"
msgstr "Direzione in cui crescono i valori lungo l'asse orizzontale. Specificare -1 per invertire l'ordine dei valori"

#: templates/admin/chart_wizard/steps/step4.inc.php:1013
msgid "Vertical axis label"
msgstr "Etichetta asse verticale"

#: templates/admin/chart_wizard/steps/step4.inc.php:1015
msgid "Name of the vertical axis."
msgstr "Nome dell'asse verticale."

#: templates/admin/chart_wizard/steps/step4.inc.php:1030
msgid "Vertical crosshair"
msgstr "Incrocio verticale"

#: templates/admin/chart_wizard/steps/step4.inc.php:1032
msgid "Configure a vertical crosshair that follows either the mouse pointer or the hovered point lines"
msgstr "Configura un incrocio verticale che segue il puntatore del mouse o le linee dei punti su cui si passa con il mouse"

#: templates/admin/chart_wizard/steps/step4.inc.php:1036
msgid "Show y-Axis crosshair"
msgstr "Mostra incrocio asse y"

#: templates/admin/chart_wizard/steps/step4.inc.php:1041
msgid "Vertical axis direction"
msgstr "Direzione dell'asse verticale"

#: templates/admin/chart_wizard/steps/step4.inc.php:1043
msgid "The direction in which the values along the vertical axis grow. Specify -1 to reverse the order of the values"
msgstr "Direzione in cui crescono i valori lungo l'asse verticale. Specificare -1 per invertire l'ordine dei valori"

#: templates/admin/chart_wizard/steps/step4.inc.php:1059
msgid "Stroke width"
msgstr "Spessore del tratto"

#: templates/admin/chart_wizard/steps/step4.inc.php:1061
msgid "Sets the width of border for svg path. Smaller values correspond to smaller line thickness."
msgstr "Imposta lo spessore del bordo per il tracciato svg. Valori più piccoli corrispondono a uno spessore della linea più sottile."

#: templates/admin/chart_wizard/steps/step4.inc.php:1091
msgid "Vertical axis min value"
msgstr "Valore minimo dell'asse verticale"

#: templates/admin/chart_wizard/steps/step4.inc.php:1093
msgid "The minimum value of the axis."
msgstr "Il valore minimo dell'asse."

#: templates/admin/chart_wizard/steps/step4.inc.php:1123
msgid "Vertical axis max value"
msgstr "Valore massimo dell'asse verticale"

#: templates/admin/chart_wizard/steps/step4.inc.php:1125
msgid "The maximum value of the axis."
msgstr "Il valore massimo dell'asse."

#: templates/admin/chart_wizard/steps/step4.inc.php:1153
msgid "Tick amount"
msgstr "Quantità di tacche"

#: templates/admin/chart_wizard/steps/step4.inc.php:1155
msgid "Number of tick intervals to show on the y-axis."
msgstr "Numero di intervalli di tacche da mostrare sull'asse y."

#: templates/admin/chart_wizard/steps/step4.inc.php:1183
msgid "Invert"
msgstr "Inverti"

#: templates/admin/chart_wizard/steps/step4.inc.php:1185
msgid "Whether to invert the axes so that the x axis is vertical and y axis is horizontal"
msgstr "Se invertire gli assi in modo che l'asse x sia verticale e l'asse y sia orizzontale"

