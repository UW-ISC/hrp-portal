msgstr "L'URL di un'immagine da utilizzare come sfondo del grafico."

#: templates/admin/chart_wizard/steps/step4.inc.php:419
msgid "Chart area/line image"
msgstr "Immagine del grafico ad area/linea"

#: templates/admin/chart_wizard/steps/step4.inc.php:421
msgid "The URL for an image to use as the background image of the chart area or line. If you have multiple series, this image is applied to all of them. If you want each series to have a different image property, leave this blank."
msgstr "L'URL di un'immagine da utilizzare come immagine di sfondo dell'area o della linea del grafico. Se sono presenti più serie, questa immagine viene applicata a tutte. Se si desidera che ogni serie abbia una proprietà immagine diversa, lasciare questo campo vuoto."

#: templates/admin/chart_wizard/steps/step4.inc.php:441
msgid "Monochrome"
msgstr "Monocromatico"

#: templates/admin/chart_wizard/steps/step4.inc.php:443
msgid "A single color will be used as a base and shades for the chart will be generated from that color"
msgstr "Verrà utilizzato un unico colore come base e le sfumature del grafico saranno generate da quel colore"

#: templates/admin/chart_wizard/steps/step4.inc.php:447
msgid "Enable monochrome color palette"
msgstr "Abilita tavolozza colori monocromatica"

#: templates/admin/chart_wizard/steps/step4.inc.php:452
msgid "Monochrome color to use"
msgstr "Colore monocromatico da utilizzare"

#: templates/admin/chart_wizard/steps/step4.inc.php:454
