msgstr "Selezionare per grafico a torta 3D"

#: templates/admin/chart_wizard/steps/step4.inc.php:849
msgid "Grid"
msgstr "Griglia"

#: templates/admin/chart_wizard/steps/step4.inc.php:855
msgid "Do you want to show grid on the chart?"
msgstr "Desideri visualizzare una griglia sul grafico?"

#: templates/admin/chart_wizard/steps/step4.inc.php:860
msgid "Grid line color"
msgstr "Colore delle linee della griglia"

#: templates/admin/chart_wizard/steps/step4.inc.php:862
msgid "Color of grid borders / lines"
msgstr "Colore dei bordi/delle linee della griglia"

