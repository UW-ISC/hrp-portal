#: templates/admin/table-settings/table_settings_block.inc.php:178
msgid "Please choose a file location (WordPress Media Library or URL from any domain) for CSV or Excel files. Default option is WordPress Media Library."
msgstr "Scegliere una posizione del documento (libreria Media di WordPress o URL da qualsiasi dominio) per i documenti CSV o Excel. L'opzione predefinita è libreria Media di WordPress."

