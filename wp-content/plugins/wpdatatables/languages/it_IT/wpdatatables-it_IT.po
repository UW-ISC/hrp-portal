msgstr "Scegli quali pulsanti visualizzare nella sezione utilità tabella."

#: templates/admin/table-settings/table_settings_block.inc.php:1300
msgid "Columns visibility"
msgstr "Visibilità colonne"

#: templates/admin/table-settings/table_settings_block.inc.php:1314
#: templates/admin/table-settings/table_settings_block.inc.php:1322
msgid "Include HTML"
msgstr "Includi HTML"

