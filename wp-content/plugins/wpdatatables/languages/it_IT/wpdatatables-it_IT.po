#: templates/admin/chart_wizard/steps/step4.inc.php:508
msgid "Marker size"
msgstr "Dimensione indicatore"

#: templates/admin/chart_wizard/steps/step4.inc.php:510
msgid "Sets the size of the marker point. For larger amounts of data points, it is recommended to set this to 0 to optimize performance."
msgstr "Imposta la dimensione del punto indicatore. Per quantità maggiori di punti dati, si consiglia di impostare questo valore su 0 per ottimizzare le prestazioni."

#: templates/admin/chart_wizard/steps/step4.inc.php:541
#: templates/admin/chart_wizard/steps/step4.inc.php:1797
msgid "Data labels"
msgstr "Etichette dati"

#: templates/admin/chart_wizard/steps/step4.inc.php:543
msgid "If you leave this checked, data labels will be shown on the chart. For larger amounts of data, it is recommended to keep this option turned off for optimal perfermance."
msgstr "Se lasci questa opzione selezionata, le etichette dati verranno visualizzate sul grafico. Per quantità maggiori di dati, si consiglia di mantenere questa opzione disattivata per ottenere prestazioni ottimali."

#: templates/admin/chart_wizard/steps/step4.inc.php:547
#: templates/admin/chart_wizard/steps/step4.inc.php:1803
msgid "Show data labels"
msgstr "Mostra etichette dati"

#: templates/admin/chart_wizard/steps/step4.inc.php:553
