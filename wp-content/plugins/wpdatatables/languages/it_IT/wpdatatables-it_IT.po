msgid "Invert chart axes"
msgstr "Inverti assi del grafico"

#: templates/admin/chart_wizard/steps/step4.inc.php:1194
#: templates/admin/chart_wizard/steps/step4.inc.php:1200
msgid "Reverse y-axis"
msgstr "Inverti asse Y"

#: templates/admin/chart_wizard/steps/step4.inc.php:1196
msgid "Flip the chart upside down making it inversed and draw y-axis from bigger to smaller numbers."
msgstr "Capovolgi il grafico rendendolo invertito e disegna l'asse Y dai numeri più grandi a quelli più piccoli."

#: templates/admin/chart_wizard/steps/step4.inc.php:1210
msgid "Chart title"
msgstr "Titolo del grafico"

#: templates/admin/chart_wizard/steps/step4.inc.php:1212
msgid "Do you want to show the chart title on the page?"
msgstr "Vuoi mostrare il titolo del grafico sulla pagina?"

#: templates/admin/chart_wizard/steps/step4.inc.php:1216
msgid "Show title"
msgstr "Mostra titolo"

#: templates/admin/chart_wizard/steps/step4.inc.php:1221
msgid "Title floating"
msgstr "Titolo fluttuante"

#: templates/admin/chart_wizard/steps/step4.inc.php:1223
msgid "When the title is floating, the plot area will not move to make space for it"
msgstr "Quando il titolo è fluttuante, l'area del grafico non si sposta per fare spazio al titolo"

#: templates/admin/chart_wizard/steps/step4.inc.php:1227
msgid "Enable floating"
msgstr "Abilita fluttuante"

#: templates/admin/chart_wizard/steps/step4.inc.php:1232
msgid "Title align"
msgstr "Allineamento titolo"

#: templates/admin/chart_wizard/steps/step4.inc.php:1234
msgid "The horizontal alignment of the title"
msgstr "Allineamento orizzontale del titolo"

#: templates/admin/chart_wizard/steps/step4.inc.php:1250
msgid "Title position"
msgstr "Posizione titolo"

#: templates/admin/chart_wizard/steps/step4.inc.php:1252
msgid "Position of the title. Possible values are 'top', 'left', 'bottom' and 'right'"
msgstr "Posizione del titolo. I valori possibili sono “in alto”, “a sinistra”, “in basso” e “a destra”."

#: templates/admin/chart_wizard/steps/step4.inc.php:1269
msgid "Title font name"
msgstr "Nome del carattere del titolo"

#: templates/admin/chart_wizard/steps/step4.inc.php:1271
msgid "The default font face for text in the title."
msgstr "Il carattere predefinito per il testo del titolo."

#: templates/admin/chart_wizard/steps/step4.inc.php:1286
msgid "Title font style"
msgstr "Stile del carattere del titolo"

#: templates/admin/chart_wizard/steps/step4.inc.php:1288
msgid "The default font style for text in the title"
msgstr "Lo stile predefinito per il testo del titolo"

#: templates/admin/chart_wizard/steps/step4.inc.php:1303
msgid "Title font weight"
msgstr "Spessore del carattere del titolo"

#: templates/admin/chart_wizard/steps/step4.inc.php:1305
msgid "The default font weight for text in the title"
msgstr "Lo spessore predefinito per il testo del titolo"

#: templates/admin/chart_wizard/steps/step4.inc.php:1320
msgid "Title font color"
msgstr "Colore del carattere del titolo"

#: templates/admin/chart_wizard/steps/step4.inc.php:1322
msgid "The default font color for text in the title."
msgstr "Il colore predefinito per il testo del titolo."

#: templates/admin/chart_wizard/steps/step4.inc.php:1339
msgid "Subtitle"
msgstr "Sottotitolo"

#: templates/admin/chart_wizard/steps/step4.inc.php:1341
msgid "The chart's subtitle."
msgstr "Il sottotitolo del grafico."

#: templates/admin/chart_wizard/steps/step4.inc.php:1356
msgid "Subtitle align"
msgstr "Allineamento sottotitolo"

#: templates/admin/chart_wizard/steps/step4.inc.php:1358
msgid "The horizontal alignment of the subtitle"
msgstr "L'allineamento orizzontale del sottotitolo"

#: templates/admin/chart_wizard/steps/step4.inc.php:1381
msgid "Enable or disable the tooltip"
msgstr "Abilita o disabilita il tooltip"

#: templates/admin/chart_wizard/steps/step4.inc.php:1385
msgid "Show tooltip"
msgstr "Mostra tooltip"

#: templates/admin/chart_wizard/steps/step4.inc.php:1392
msgid "The background color for the tooltip."
msgstr "Il colore di sfondo del tooltip."

#: templates/admin/chart_wizard/steps/step4.inc.php:1411
msgid "The pixel width of the tooltip border."
msgstr "La larghezza in pixel del bordo del tooltip."

#: templates/admin/chart_wizard/steps/step4.inc.php:1441
msgid "The color of the tooltip border."
msgstr "Il colore del bordo del tooltip."

#: templates/admin/chart_wizard/steps/step4.inc.php:1460
msgid "The radius of the rounded border corners."
msgstr "Il raggio degli angoli arrotondati del bordo."

#: templates/admin/chart_wizard/steps/step4.inc.php:1488
msgid "Shared tooltip"
msgstr "Tooltip condiviso"

#: templates/admin/chart_wizard/steps/step4.inc.php:1490
msgid "When the tooltip is shared, the entire plot area will capture mouse movement or touch events"
msgstr "Quando il suggerimento è condiviso, l'intera area del grafico catturerà i movimenti del mouse o gli eventi tattili"

