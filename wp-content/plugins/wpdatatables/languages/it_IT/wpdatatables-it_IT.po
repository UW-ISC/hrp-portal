msgstr "Imposta la distanza di sfocatura dell'ombra. È possibile impostare qualsiasi valore a partire da 1."

#: templates/admin/chart_wizard/steps/step4.inc.php:590
msgid "Dropshadow opacity"
msgstr "Opacità ombra"

#: templates/admin/chart_wizard/steps/step4.inc.php:592
