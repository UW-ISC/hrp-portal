#: templates/admin/table-settings/table_settings_block.inc.php:790
msgid "Info block"
msgstr "Sezione informazioni"

#: templates/admin/table-settings/table_settings_block.inc.php:797
msgid "Enable to show a block of information about the number of records below the table."
msgstr "Abilita per mostrare una sezione di informazioni sul numero di record sotto la tabella."

#: templates/admin/table-settings/table_settings_block.inc.php:805
msgid "Show information block below the table"
msgstr "Mostra sezione informazioni sotto la tabella"

#: templates/admin/table-settings/table_settings_block.inc.php:829
msgid "This should be turned on if you want to set columns width manually. Should be on to use word wrapping."
msgstr "Questa opzione deve essere attivata se si desidera impostare manualmente la larghezza delle colonne. Deve essere attivata per utilizzare il ritorno a capo automatico."

#: templates/admin/table-settings/table_settings_block.inc.php:876
#: templates/admin/table-settings/table_settings_block.inc.php:884
msgid "Return to table top"
msgstr "Torna all'inizio della tabella"

