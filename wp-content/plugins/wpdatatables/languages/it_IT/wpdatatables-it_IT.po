msgstr "Pulsanti “Primo”, “Precedente”, ‘Successivo’ e “Ultimo”, più numeri di pagina"

#: templates/admin/table-settings/table_settings_block.inc.php:988
#: templates/admin/table-settings/table_settings_block.inc.php:1021
msgid "\"Previous\" and \"Next\" buttons only"
msgstr "Solo pulsanti “Precedente” e “Successivo”"

#: templates/admin/table-settings/table_settings_block.inc.php:989
#: templates/admin/table-settings/table_settings_block.inc.php:1022
msgid "\"Previous\" and \"Next\" buttons, plus page numbers"
msgstr "Pulsanti “Precedente” e “Successivo”, più numeri di pagina"

#: templates/admin/table-settings/table_settings_block.inc.php:990
#: templates/admin/table-settings/table_settings_block.inc.php:1023
msgid "\"First\", \"Previous\", \"Next\" and \"Last\" buttons"
msgstr "Pulsanti “Primo”, “Precedente”, “Successivo” e “Ultimo”"

#: templates/admin/table-settings/table_settings_block.inc.php:991
#: templates/admin/table-settings/table_settings_block.inc.php:1024
msgid "Page number buttons only"
msgstr "Solo pulsanti con numeri di pagina"

#: templates/admin/table-settings/table_settings_block.inc.php:992
#: templates/admin/table-settings/table_settings_block.inc.php:1025
msgid "\"First\" and \"Last\" buttons, plus page numbers"
msgstr "Pulsanti “Primo” e “Ultimo”, più numeri di pagina"

#: templates/admin/table-settings/table_settings_block.inc.php:1000
msgid "Pagination Layout for mobile"
msgstr "Layout di paginazione per dispositivi mobili"

#: templates/admin/table-settings/table_settings_block.inc.php:1008
msgid "Pagination Layout for mobile devices"
msgstr "Layout di paginazione per dispositivi mobili"

#: templates/admin/table-settings/table_settings_block.inc.php:1012
msgid "Here you can choose between different pagination layout for mobile devices."
msgstr "Qui è possibile scegliere tra diversi layout di paginazione per dispositivi mobili."

#: templates/admin/table-settings/table_settings_block.inc.php:1045
msgid "Advanced column filters"
msgstr "Filtri avanzati per colonne"

#: templates/admin/table-settings/table_settings_block.inc.php:1053
msgid "Advanced filter"
msgstr "Filtro avanzato"

#: templates/admin/table-settings/table_settings_block.inc.php:1060
msgid "Enable to show an advanced filter for each of the columns, filters can be shown in table footer, header or in a separate form."
msgstr "Abilita per mostrare un filtro avanzato per ciascuna delle colonne; i filtri possono essere visualizzati nel piè di pagina, nell'intestazione o in un modulo separato."

#: templates/admin/table-settings/table_settings_block.inc.php:1068
msgid "Enable advanced column filters"
msgstr "Abilita filtri avanzati per colonne"

#: templates/admin/table-settings/table_settings_block.inc.php:1091
msgid "If this is enabled, each column header will be clickable; clicking will sort the whole table by the content of this column cells ascending or descending."
msgstr "Se questa opzione è abilitata, ciascuna intestazione di colonna sarà cliccabile; cliccandoci sopra, l'intera tabella verrà ordinata in base al contenuto delle celle di quella colonna in ordine crescente o decrescente."

#: templates/admin/table-settings/table_settings_block.inc.php:1099
msgid "Allow sorting for the table"
msgstr "Consenti l'ordinamento della tabella"

#: templates/admin/table-settings/table_settings_block.inc.php:1107
msgid "Main search block"
msgstr "Sezione principale di ricerca"

#: templates/admin/table-settings/table_settings_block.inc.php:1122
msgid "If this is enabled, a search block will be displayed on the top right of the table, allowing to search through whole table with a single input."
msgstr "Se questa opzione è abilitata, nella parte superiore destra della tabella verrà visualizzata una sezione di ricerca che consentirà di effettuare ricerche nell'intera tabella con un unico input."

#: templates/admin/table-settings/table_settings_block.inc.php:1130
msgid "Enable search block"
msgstr "Abilita sezione di ricerca"

#: templates/admin/table-settings/table_settings_block.inc.php:1144
msgid "Filters in a form"
msgstr "Filtri in un modulo"

#: templates/admin/table-settings/table_settings_block.inc.php:1151
msgid "Filter in form"
msgstr "Filtro nel modulo"

#: templates/admin/table-settings/table_settings_block.inc.php:1158
msgid "Enable to show the advanced column filter in a form above the table, instead of showing in the table footer/header."
msgstr "Abilita per mostrare il filtro avanzato delle colonne in un modulo sopra la tabella, invece che nell'intestazione/piè di pagina della tabella."

#: templates/admin/table-settings/table_settings_block.inc.php:1166
