msgstr "Lo stile predefinito del carattere per tutto il testo nel grafico (eccetto titolo e tooltip)."

#: templates/admin/chart_wizard/steps/step4.inc.php:798
msgid "Font weight"
msgstr "Spessore carattere"

#: templates/admin/chart_wizard/steps/step4.inc.php:800
msgid "The default font weight for all text in the chart (except title and tooltip)"
msgstr "Lo spessore predefinito del carattere per tutto il testo nel grafico (eccetto titolo e suggerimento)."

#: templates/admin/chart_wizard/steps/step4.inc.php:815
