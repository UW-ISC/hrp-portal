msgid "Activate this option to automatically scroll users to the top of the table after the pagination button clicks."
msgstr "Attiva questa opzione per far scorrere automaticamente gli utenti all'inizio della tabella dopo aver cliccato sul pulsante di impaginazione."

#: templates/admin/table-settings/table_settings_block.inc.php:895
msgid "Return to table top after pagination click"
msgstr "Torna all'inizio della tabella dopo aver cliccato sull'impaginazione"

#: templates/admin/table-settings/table_settings_block.inc.php:920
msgid "Enable to show a pagination"
msgstr "Abilita per mostrare la paginazione"

#: templates/admin/table-settings/table_settings_block.inc.php:928
msgid "Show pagination block below the table"
msgstr "Mostra la sezione paginazione sotto la tabella"

