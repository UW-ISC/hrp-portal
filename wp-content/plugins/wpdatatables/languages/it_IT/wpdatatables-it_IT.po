#: templates/admin/table-settings/table_settings_block.inc.php:219
msgid "Insert JSON URL. Please note that you are able to use dynamic Placeholders for this input like https://api.com/v1/data/%VAR1%/"
msgstr "Inserisci l'URL JSON. Tieni presente che per questo input puoi utilizzare segnaposto dinamici come https://api.com/v1/data/%VAR1%/"

#: templates/admin/table-settings/table_settings_block.inc.php:225
