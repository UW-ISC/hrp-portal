msgstr "Il carattere predefinito per tutto il testo nel grafico."

#: templates/admin/chart_wizard/steps/step4.inc.php:781
msgid "Font style"
msgstr "Stile carattere"

#: templates/admin/chart_wizard/steps/step4.inc.php:783
