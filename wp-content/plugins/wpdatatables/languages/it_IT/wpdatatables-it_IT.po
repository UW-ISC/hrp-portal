#: templates/admin/table-settings/table_settings_block.inc.php:320
msgid "Set JSON authentication option. You can choose \"Basic Authentication\" with username and password or \"No Auth\" option. By default is set to \"No Auth\"."
msgstr "Imposta l'opzione di autenticazione JSON. È possibile scegliere l'opzione “Autenticazione di base” con nome utente e password o l'opzione “Nessuna autenticazione”. L'impostazione predefinita è “Nessuna autenticazione”."

#: templates/admin/table-settings/table_settings_block.inc.php:327
msgid "No Auth"
msgstr "Nessuna autenticazione"

#: templates/admin/table-settings/table_settings_block.inc.php:328
