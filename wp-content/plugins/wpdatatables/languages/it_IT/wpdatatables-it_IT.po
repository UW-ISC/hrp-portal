msgstr "Scegli le colonne della tabella che desideri utilizzare nel grafico. Puoi trascinare i blocchi delle colonne oppure cliccare per selezionarli e utilizzare i controlli al centro per aggiungerli o rimuoverli dal grafico."

#: templates/admin/chart_wizard/steps/step3.inc.php:20
msgid "Add all"
msgstr "Aggiungi tutto"

#: templates/admin/chart_wizard/steps/step3.inc.php:22
msgid "Add"
msgstr "Aggiungi"

#: templates/admin/chart_wizard/steps/step3.inc.php:26
msgid "Remove all"
msgstr "Rimuovi tutto"

#: templates/admin/chart_wizard/steps/step3.inc.php:31
