msgstr "Pulsante Cancella filtri"

#: templates/admin/table-settings/table_settings_block.inc.php:1185
msgid "Enable to show the clear filters button."
msgstr "Abilita per mostrare il pulsante Cancella filtri."

#: templates/admin/table-settings/table_settings_block.inc.php:1187
msgid "If filter in form is enabled, clear button will be rendered after the last filter."
msgstr "Se il filtro nel modulo è abilitato, il pulsante \"Cancella\" verrà visualizzato dopo l'ultimo filtro."

#: templates/admin/table-settings/table_settings_block.inc.php:1192
msgid "Otherwise, clear filter button will be rendered above the table next to \"Table Tools\" buttons."
msgstr "Altrimenti, il pulsante \"Cancella filtri\" verrà visualizzato sopra la tabella accanto ai pulsanti “Utilità tabella”."

#: templates/admin/table-settings/table_settings_block.inc.php:1204
msgid "Show clear filters button"
msgstr "Mostra pulsante \"Cancella filtri\""

#: templates/admin/table-settings/table_settings_block.inc.php:1269
msgid "Table tools"
msgstr "Utilità tabella"

#: templates/admin/table-settings/table_settings_block.inc.php:1276
msgid "If this is enabled, a toolbar with useful tools will be shown above the table"
msgstr "Se questa opzione è abilitata, sopra la tabella verrà visualizzata una barra degli strumenti con strumenti utili"

#: templates/admin/table-settings/table_settings_block.inc.php:1284
msgid "Enable Table Tools"
msgstr "Abilita utilità tabella"

#: templates/admin/table-settings/table_settings_block.inc.php:1292
