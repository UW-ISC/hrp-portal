msgstr "Consente di impostare un tasto per passare dallo zoom alla panoramica e viceversa"

#: templates/admin/chart_wizard/steps/step4.inc.php:379
msgid "Plot background color"
msgstr "Colore di sfondo del grafico"

#: templates/admin/chart_wizard/steps/step4.inc.php:381
