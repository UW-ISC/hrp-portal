#: templates/admin/table-settings/table_settings_block.inc.php:979
msgid "Here you can choose between different pagination layout."
msgstr "Qui puoi scegliere tra diversi layout di paginazione."

#: templates/admin/table-settings/table_settings_block.inc.php:987
#: templates/admin/table-settings/table_settings_block.inc.php:1020
