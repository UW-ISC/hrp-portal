msgid "Failed to describe table \"%s\"."
msgstr "Nie udało się opisać tabeli „%s”."

#: backend/src/Infrastructure/WP/MCP/Abilities/list-db-tables.php:161
msgid "Failed to list tables on the WordPress database."
msgstr "Nie udało się wyświetlić listy tabel w bazie danych WordPress."

#: backend/src/Infrastructure/WP/MCP/Abilities/list-db-tables.php:220
msgid "table_name is required."
msgstr "nazwa_tabeli jest wymagana."

