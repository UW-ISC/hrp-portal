msgstr "Для работы требуются основные классы wpDataTables: WPDataTableRows и WDTConfigController."

#: backend/src/Infrastructure/WP/MCP/Abilities/create-simple-table.php:122
msgid "rows must be an array."
msgstr "rows должен быть массивом."

