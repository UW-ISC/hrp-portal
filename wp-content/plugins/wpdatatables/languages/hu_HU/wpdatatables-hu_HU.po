msgstr " 1, 3, 7, 15, 45, 200"

#: templates/admin/table-settings/table_settings_block.inc.php:692
msgid " 5,12,25,100,-1"
msgstr " 5, 12, 25, 100,-1"

#: templates/admin/table-settings/table_settings_block.inc.php:694
msgid " 1,100,200,300"
msgstr " 1 100 200 300"

#: templates/admin/table-settings/table_settings_block.inc.php:696
msgid " 20,40,60,80,-1"
msgstr " 20, 40, 60, 80, -1"

