msgstr "A wpDataTables alaposztályai kötelezőek."

#: backend/src/Infrastructure/WP/MCP/Abilities/create-table-from-query.php:375
msgid "wpDataTables wdtSanitizeQuery is required."
msgstr "A wpDataTables és a wdtSanitizeQuery megadása kötelező."

#: backend/src/Infrastructure/WP/MCP/Abilities/create-table-from-query.php:459
msgid "Failed to create table record."
msgstr "Nem sikerült létrehozni a táblarekordot."

#: backend/src/Infrastructure/WP/MCP/Abilities/create-table-from-query.php:479
#: backend/src/Infrastructure/WP/MCP/Abilities/create-table-from-source.php:562
