#: Infrastructure/WP/MCP/Abilities/create-table-from-query.php:138
#, php-format
msgid "Query could not be parsed: %s"
msgstr ""

#: Infrastructure/WP/MCP/Abilities/create-table-from-query.php:160
msgid "UNION queries are not permitted. Use a single SELECT statement."
msgstr ""

#: Infrastructure/WP/MCP/Abilities/create-table-from-query.php:167
#: Infrastructure/WP/MCP/Abilities/create-table-from-query.php:235
msgid "Only SELECT queries are allowed. INSERT, UPDATE, DELETE, DROP, TRUNCATE, CREATE, ALTER, EXPLAIN, DESCRIBE, and UNION are not permitted."
