#: backend/src/Services/Localization/TranslationStringsProvider.php:46
#: backend/src/Services/Localization/TranslationStringsProvider.php:125
msgid "<small>You've selected the <strong>'Replace rows with source data'</strong> option. This means that you're about to <strong>delete all the data</strong> you currently have in your table and replace it with data from your source file.<br><br> If you have any <strong>date type columns</strong> in your file, please make sure you set the <strong>date input format in Main settings of plugin</strong> to the one you're using in your source file first.<br><br>Please consider <strong>duplicating your table first</strong>, before updating.<br><br><strong>There is no undo.</strong></small> "
msgstr "<small>Izbrali ste možnost <strong>»Zamenjaj vrstice z izvornimi podatki«</strong>. To pomeni, da boste <strong>izbrisali vse podatke</strong>, ki jih trenutno imate v tabeli, in jih zamenjali s podatki iz izvorne datoteke.<br><br>Če imate v datoteki kakršne koli stolpce tipa <strong>z datumom</strong>, najprej nastavite vhodno obliko datuma <strong>v glavnih nastavitvah vtičnika</strong> na tisto, ki jo uporabljate v izvorni datoteki.<br><br>Pred posodobitvijo razmislite o podvajanju tabele <strong></strong>.<br><br><strong>Razveljavitve ni mogoče.</strong></small> "

#: backend/src/Services/Localization/TranslationStringsProvider.php:47
#: backend/src/Services/Localization/TranslationStringsProvider.php:126
msgid "<small>You've selected the <strong>'Add data to current table data'</strong> option. This means that you're about to <strong>add data</strong> from the file source to your table.<br><br> If you have any <strong>date type columns</strong> in your file, please make sure you set the <strong>date input format in Main settings of plugin</strong> to the one you're using in your source file first.<br><br>Please consider <strong>duplicating your table first</strong>, before updating.<br><br><strong>There is no undo.</strong></small>"
msgstr "<small>Izbrali ste možnost <strong>»Dodaj podatke trenutnim podatkom tabele«</strong>. To pomeni, da boste <strong>dodali podatke</strong> iz izvorne datoteke v svojo tabelo.<br><br> Če imate v datoteki kakršne koli stolpce tipa <strong> z datumom</strong>, najprej nastavite vhodno obliko datuma <strong> v glavnih nastavitvah vtičnika</strong> na tisto, ki jo uporabljate v izvorni datoteki.<br><br>Prosimo, razmislite o <strong>preden posodobite, najprej podvojite tabelo</strong>.<br><br><strong>Razveljavitve ni mogoče.</strong></small>"

#: backend/src/Services/Localization/TranslationStringsProvider.php:48
#: backend/src/Services/Localization/TranslationStringsProvider.php:127
msgid "<small>You've selected the <strong>'Replace entire table data'</strong> option. This means that you're about to <strong>delete your entire table data and current column settings</strong> and replace it with data from your source file with default settings for columns.<br><br> If you have any <strong>date type columns</strong> in your file, please make sure you set the <strong>date input format in Main settings of plugin</strong> to the one you're using in your source file first. <br><br>Please consider <strong>duplicating your table first</strong>, before updating.<br><br><strong>There is no undo.</strong></small> "
msgstr "<small>Izbrali ste možnost <strong>»Zamenjaj celotne podatke tabele«</strong>. To pomeni, da boste <strong>izbrisali celotne podatke tabele in trenutne nastavitve stolpcev</strong> ter jih zamenjali s podatki iz izvorne datoteke s privzetimi nastavitvami za stolpce.<br><br> Če imate v datoteki kakršne koli stolpce tipa <strong> z datumom</strong>, najprej nastavite vhodno obliko datuma <strong> v glavnih nastavitvah vtičnika</strong> na tisto, ki jo uporabljate v izvorni datoteki. <br><br>Prosimo, razmislite o <strong>preden posodobite, podvojite tabelo</strong>.<br><br><strong>Razveljavitve ni mogoče.</strong></small> "

