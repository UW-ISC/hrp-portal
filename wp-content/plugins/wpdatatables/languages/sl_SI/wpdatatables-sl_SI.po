msgstr "Uporabnik nima dovoljenj za brisanje te vrstice! "

#: backend/src/Services/Permissions/TableRowActionPermissionsChecker.php:52
msgid "User do not have permission to update data!"
msgstr "Uporabnik nima dovoljenja za posodabljanje podatkov!"

#: backend/src/Services/Permissions/TableRowActionPermissionsChecker.php:74
msgid "User does not have permissions to delete this row! "
msgstr "Uporabnik nima dovoljenj za brisanje te vrstice! "

#: backend/src/Services/Permissions/TableRowActionPermissionsChecker.php:76
msgid "User does not have permission to update data!"
msgstr "Uporabnik nima dovoljenja za posodabljanje podatkov!"

#: backend/src/Entity/Chart/RuntimeChart.php:826
msgid "Only one column can be of type String"
msgstr "Samo en stolpec je lahko vrste String"

#: backend/src/Entity/Chart/RuntimeChart.php:829
msgid "You are mixing data types (several date axes and several number)"
msgstr "Mešate podatkovne vrste (več datumskih osi in več številk)"

#: backend/src/Services/DataSource/MySqlQueryDataSource.php:725
msgid "No data fetched!  <br/> To create a wpDataTable, at least one row of data is required before saving. This ensures the table is generated correctly. If needed, you can remove the row later. <br/>"
msgstr "Ni pridobljenih podatkov! <br/> Za ustvarjanje tabele wpDataTable je pred shranjevanjem potrebna vsaj ena vrstica podatkov. To zagotavlja pravilno generiranje tabele. Po potrebi lahko vrstico pozneje odstranite. <br/>"

#: backend/src/Services/DataSource/MySqlQueryDataSource.php:727
msgid "Rendered query: "
msgstr "Izdelana poizvedba:"

#: backend/src/Services/DataSource/MySqlQueryDataSource.php:729
msgid " MySQL said: "
msgstr "MySQL je rekel:"

#: backend/src/Services/DataSource/ExcelDataSource.php:54
